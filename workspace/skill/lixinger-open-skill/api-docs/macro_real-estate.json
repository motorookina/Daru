{
  "api": "房地产",
  "apiKey": "macro/real-estate",
  "description": {
    "cmn_hans_cn": "获取房地产数据。可按时间范围获取大陆房地产投资额、施工面积、新开工施工面积、竣工面积、购置土地面积、土地成交价款、商品房销售面积、商品房销售额、商品住宅房销售面积、商品住宅房销售额数据，包括存量及月度新增数据，以及同比环比等数据。当用户想了解房地产市场状况或趋势时，调用此接口。",
    "en": ""
  },
  "url": "https://open.lixinger.com/api/macro/real-estate",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "startDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息起始时间。"
      ],
      "constraints": [
        "开始和结束的时间间隔不超过10年"
