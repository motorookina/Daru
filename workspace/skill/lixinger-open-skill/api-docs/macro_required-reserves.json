{
  "api": "存款备用金",
  "apiKey": "macro/required-reserves",
  "description": {
    "cmn_hans_cn": "获取存款准备金率数据。可按时间范围获取大陆大型金融机构和中小金融机构的存款准备金率数据。当用户想了解央行货币政策调整节奏、不同规模金融机构准备金率差异或货币政策信号时，调用此接口。",
    "en": ""
  },
  "url": "https://open.lixinger.com/api/macro/required-reserves",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "startDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息起始时间。"
      ],
      "constraints": [
        "开始和结束的时间间隔不超过10年"
      ]
    },
    {
      "name": "endDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息结束时间。"
      ]
    },
    {
      "name": "limit",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "返回最近数据的数量。"
      ],
      "constraints": [
        "limit仅在请求数据为date range的情况下生效。"
      ]
    },
    {
      "name": "areaCode",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "地区代码。"
      ],
      "example": "cn",
      "items": [
        {
          "label": "大陆",
          "value": "cn"
        }
      ]
    },
    {
      "name": "metricsList",
      "required": "Yes",
      "type": "Array",
      "descriptions": [
        "指标数组。"
      ],
      "example": "'lfi_drr'",
      "regions": [
        {
          "label": "大陆支持:",
          "items": [
            {
              "label": "大型金融机构存款准备金率",
              "value": "lfi_drr",
              "ectByGranularity": []
            },
            {
              "label": "中小金融机构存款准备金率",
              "value": "masfi_drr",
              "ectByGranularity": []
            }
          ]
        }
      ]
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 通过时间范围获取",
      "requestBody": {
        "areaCode": "cn",
        "startDate": "2025-07-10",
        "endDate": "2026-07-10",
        "metricsList": [
          "lfi_drr"
        ],
        "token": "***********"
      }
    }
  ]
}