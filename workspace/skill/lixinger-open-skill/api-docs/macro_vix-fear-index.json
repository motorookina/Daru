{
  "api": "VIX恐慌指数",
  "apiKey": "macro/vix-fear-index",
  "description": {
    "cmn_hans_cn": "返回VIX恐慌指数期货CFD的日度收盘价数据。",
    "en": "Return daily close price data for VIX Fear Index Futures CFD."
  },
  "url": "https://open.lixinger.com/api/macro/vix-fear-index",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "startDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息起始时间。"
      ],
      "constraints": [
        "开始和结束的时间间隔不超过10年"
      ]
    },
    {
      "name": "endDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息结束时间。"
      ]
    },
    {
      "name": "limit",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "返回最近数据的数量。"
      ],
      "constraints": [
        "limit仅在请求数据为date range的情况下生效。"
      ]
    },
    {
      "name": "areaCode",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "地区代码。"
      ],
      "example": "us",
      "items": [
        {
          "label": "美国",
          "value": "us"
        }
      ]
    },
    {
      "name": "metricsList",
      "required": "Yes",
      "type": "Array",
      "descriptions": [
        "指标数组。"
      ],
      "example": "'vix_fic'",
      "regions": [
        {
          "label": "美国支持:",
          "items": [
            {
              "label": "VIX恐慌指数期货CFD收盘价",
              "value": "vix_fic",
              "ectByGranularity": []
            }
          ]
        }
      ]
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 通过时间范围获取",
      "requestBody": {
        "areaCode": "us",
        "startDate": "2025-07-10",
        "endDate": "2026-07-10",
        "metricsList": [
          "vix_fic"
        ],
        "token": "***********"
      }
    }
  ]
}