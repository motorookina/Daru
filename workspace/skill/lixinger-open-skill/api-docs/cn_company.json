{
  "api": "股票信息API",
  "apiKey": "cn/company",
  "description": {
    "cmn_hans_cn": "获取A股公司的基础信息列表。可按股票代码、财报类型（非金融/银行/保险/证券/其他金融）、是否是A股通标的、是否是融资融券标的、是否退市进行筛选，返回股票代码、公司名称、市场、交易所、地区、财报类型、是否A股通标的、是否融资融券标的、公司上市状态、上市时间、退市时间等数据。当用户想了解A股列表、获取A股通成分股列表、按财报类型或互联互通类型批量获取股票代码时，调用此接口。",
    "en": "Obtain a list of basic information about A-share stocks. Users can filter by stock code, financial statement type (non-financial/banking/insurance/securities/other financial), whether it's an A-share Stock Connect stock, whether it's a margin trading stock, and whether it's delisted. It returns data such as stock code, company name, market, exchange, region, financial statement type, whether it's an A-share Stock Connect stock, whether it's a margin trading stock, company listing status, listing date, and delisting date. This interface is used when users want to view the A-share list, retrieve the A-share Stock Connect constituent stock list, or retrieve stock codes in batches by financial statement type or Stock Connect type. Call this interface when users want to know which stocks are available, obtain the A-share Connect constituent list, or retrieve stock codes by financial report type or Stock Connect type."
  },
  "url": "https://open.lixinger.com/api/cn/company",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "stockCodes",
      "required": "No",
      "type": "Array",
      "descriptions": [
        "股票代码数组。"
      ],
      "constraints": [
        "stockCodes长度>=1且<=100。",
        "请参考股票信息API获取合法的stockCode。"
      ],
      "example": "[\"300750\",\"600519\",\"600157\"]"
    },
    {
      "name": "fsTableType",
      "required": "No",
      "type": "String",
      "descriptions": [
        "财报类型。"
      ],
      "example": "bank",
      "items": [
        {
          "label": "非金融",
          "value": "non_financial"
        },
        {
          "label": "银行",
          "value": "bank"
        },
        {
          "label": "保险",
          "value": "insurance"
        },
        {
          "label": "证券",
          "value": "security"
        },
        {
          "label": "其他金融",
          "value": "other_financial"
        }
      ]
    },
    {
      "name": "isMutualMarketHaFlag",
      "required": "No",
      "type": "Boolean",
      "descriptions": [
        "是否是陆股通。"
      ]
    },
    {
      "name": "isMarginTradingAndSecuritiesLendingFlag",
      "required": "No",
      "type": "Boolean",
      "descriptions": [
        "是否是融资融券标的。"
      ]
    },
    {
      "name": "includeDelisted",
      "required": "No",
      "type": "Boolean",
      "descriptions": [
        "是否包含退市股。",
        "默认值是false。"
      ]
    },
    {
      "name": "isDeListed",
      "required": "No",
      "type": "Boolean",
      "descriptions": [
        "是否已退市。"
      ]
    },
    {
      "name": "pageIndex",
      "required": "Yes",
      "type": "Number",
      "descriptions": [
        "页面索引。",
        "默认值是0。"
      ]
    }
  ],
  "responseParams": [
    {
      "name": "total",
      "type": "Number",
      "description": "公司总数"
    },
    {
      "name": "name",
      "type": "String",
      "description": "公司名称"
    },
    {
      "name": "stockCode",
      "type": "String",
      "description": "股票代码"
    },
    {
      "name": "areaCode",
      "type": "String",
      "description": "地区代码"
    },
    {
      "name": "market",
      "type": "String",
      "description": "市场"
    },
    {
      "name": "exchange",
      "type": "String",
      "description": "交易所"
    },
    {
      "name": "fsTableType",
      "type": "String",
      "description": "财报类型"
    },
    {
      "name": "mutualMarkets",
      "type": "String",
      "description": "互联互通"
    },
    {
      "name": "marginTradingAndSecuritiesLendingFlag",
      "type": "Boolean",
      "description": "是否是融资融券标的"
    },
    {
      "name": "ipoDate",
      "type": "Date",
      "description": "上市时间"
    },
    {
      "name": "delistedDate",
      "type": "Date",
      "description": "退市时间"
    },
    {
      "name": "listingStatus",
      "type": "String",
      "description": "上市状态",
      "items": [
        {
          "label": "正常上市",
          "value": "normally_listed"
        },
        {
          "label": "已退市",
          "value": "delisted"
        },
        {
          "label": "暂停上市",
          "value": "listing_suspended"
        },
        {
          "label": "ST板块",
          "value": "special_treatment"
        },
        {
          "label": "*ST",
          "value": "delisting_risk_warning"
        },
        {
          "label": "已发行未上市",
          "value": "issued_but_not_listed"
        },
        {
          "label": "预披露",
          "value": "pre_disclosure"
        },
        {
          "label": "未过会",
          "value": "unauthorized"
        },
        {
          "label": "发行失败",
          "value": "issue_failure"
        },
        {
          "label": "进入退市整理期",
          "value": "delisting_transitional_period"
        },
        {
          "label": "暂缓发行",
          "value": "ipo_suspension"
        },
        {
          "label": "暂缓上市",
          "value": "ipo_listing_suspension"
        },
        {
          "label": "停止转让",
          "value": "transfer_suspended"
        },
        {
          "label": "正常转让",
          "value": "normally_transferred"
        },
        {
          "label": "投资者适当性管理标识",
          "value": "investor_suitability_management_implemented"
        },
        {
          "label": "非上市",
          "value": "non_listed"
        },
        {
          "label": "特定债券转让",
          "value": "transfer_as_specific_bond"
        },
        {
          "label": "协议转让",
          "value": "transfer_under_agreement"
        },
        {
          "label": "其它",
          "value": "others"
        }
      ]
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 获取所有股票信息",
      "requestBody": {
        "pageIndex": 0,
        "token": "***********"
      }
    },
    {
      "desc": "示例2: 获取指定财报类型的所有股票信息",
      "requestBody": {
        "fsTableType": "non_financial",
        "pageIndex": 0,
        "token": "***********"
      }
    },
    {
      "desc": "示例3: 获取指定股票信息",
      "requestBody": {
        "stockCodes": [
          "300750",
          "600519",
          "600157"
        ],
        "token": "***********"
      }
    },
    {
      "desc": "示例4: 获取A股通股票数据。",
      "requestBody": {
        "isMutualMarketHaFlag": true,
        "pageIndex": 0,
        "token": "***********"
      }
    }
  ]
}