{
  "api": "最新资产规模信息API",
  "apiKey": "cn/fund/hot/f_as",
  "description": {
    "cmn_hans_cn": "获取大陆公募基金的最新资产规模信息。可按基金代码批量查询，返回基金代码、基金总资产规模及日期、场内公募基金资产规模及日期等数据。当用户想了解某公募基金或者对比某些公募基金的当前的管理规模，判断基金体量大小时，调用此接口。",
    "en": "Obtain latest asset scale information for A-share funds. Supports batch query by fund code, returning fields such as fund code, total fund asset scale and date, exchange-traded fund asset scale and date. Call this interface when users want to understand the current management scale of a fund or assess its size."
  },
  "url": "https://open.lixinger.com/api/cn/fund/hot/f_as",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "stockCodes",
      "required": "No",
      "type": "Array",
      "descriptions": [
        "基金代码数组。"
      ],
      "constraints": [
        "stockCodes长度>=1且<=100。",
        "请参考基金信息API获取合法的stockCode。"
      ],
      "example": "[\"161725\",\"005827\"]"
    },
    {
      "name": "sortName",
      "required": "No",
      "type": "String",
      "descriptions": [
        "排序字段。"
      ],
      "constraints": [
        "不提供stockCodes时必填。"
      ]
    },
    {
      "name": "sortOrder",
      "required": "No",
      "type": "String",
      "descriptions": [
        "排序顺序，asc或者desc。"
      ],
      "constraints": [
        "不提供stockCodes时必填。"
      ]
    },
    {
      "name": "pageIndex",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "页码，从0开始。"
      ],
      "constraints": [
        "默认值为 0。必须是大于等于 0 的整数。"
      ]
    },
    {
      "name": "pageSize",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "每页记录数。"
      ],
      "constraints": [
        "取值范围 1 至 100，默认 100。"
      ]
    }
  ],
  "responseParams": [
    {
      "name": "stockCode",
      "type": "String",
      "description": "股票代码"
    },
    {
      "name": "f_tas",
      "type": "Number",
      "description": "总资产规模"
    },
    {
      "name": "f_tas_d",
      "type": "Date",
      "description": "总资产规模日期"
    },
    {
      "name": "fet_as",
      "type": "Number",
      "description": "基金场内规模"
    },
    {
      "name": "fet_as_d",
      "type": "Date",
      "description": "基金场内规模日期"
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 通过基金代码获取",
      "requestBody": {
        "stockCodes": [
          "161725",
          "005827"
        ],
        "token": "***********"
      }
    },
    {
      "desc": "示例2: 通过sortName获取",
      "requestBody": {
        "sortName": "f_tas",
        "sortOrder": "desc",
        "pageIndex": 0,
        "pageSize": 50,
        "token": "***********"
      }
    }
  ]
}