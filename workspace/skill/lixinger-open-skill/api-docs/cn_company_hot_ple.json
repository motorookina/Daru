{
  "api": "股权质押API",
  "apiKey": "cn/company/hot/ple",
  "description": {
    "cmn_hans_cn": "获取A股公司的股权质押汇总数据。可按股票代码批量查询，返回最新数据日期、质押比例、质押笔数、质押数量、质押市值、质押占总股本比等数据。当用户想查询某段时间下股权质押数据变化最大的前N家公司、或者查询某上市公司或者对比某些上市公司在不同周期下的整体质押风险数量和比例的统计数据，评估大股东质押比例时，调用此接口。",
    "en": "Obtain summarized equity pledge data for A-share stocks. Supports batch query by stock code, returning fields such as latest data date, pledge ratio, pledge count, pledge quantity, pledge market value, and pledge as percentage of total capital. Call this interface when users want to understand the overall pledge risk level of an A-share or assess the pledge ratio of major shareholders."
  },
  "url": "https://open.lixinger.com/api/cn/company/hot/ple",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "stockCodes",
      "required": "No",
      "type": "Array",
      "descriptions": [
        "股票代码数组。"
      ],
      "constraints": [
        "stockCodes长度>=1且<=100。",
        "请参考股票信息API获取合法的stockCode。"
      ],
      "example": "[\"300750\",\"600519\",\"600157\"]"
    },
    {
      "name": "sortName",
      "required": "No",
      "type": "String",
      "descriptions": [
        "排序字段。"
      ],
      "constraints": [
        "不提供stockCodes时必填。"
      ]
    },
    {
      "name": "sortOrder",
      "required": "No",
      "type": "String",
      "descriptions": [
        "排序顺序，asc或者desc。"
      ],
      "constraints": [
        "不提供stockCodes时必填。"
      ]
    },
    {
      "name": "pageIndex",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "页码，从0开始。"
      ],
      "constraints": [
        "默认值为 0。必须是大于等于 0 的整数。"
      ]
    },
    {
      "name": "pageSize",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "每页记录数。"
      ],
      "constraints": [
        "取值范围 1 至 100，默认 100。"
      ]
    }
  ],
  "responseParams": [
    {
      "name": "stockCode",
      "type": "String",
      "description": "股票代码"
    },
    {
      "name": "last_data_date",
      "type": "Date",
      "description": "数据时间"
    },
    {
      "name": "ps_sc_r",
      "type": "Number",
      "description": "股权质押占A股比例"
    },
    {
      "name": "pc",
      "type": "Number",
      "description": "质押笔数"
    },
    {
      "name": "ps",
      "type": "Number",
      "description": "质押股数"
    },
    {
      "name": "ps_mc",
      "type": "Number",
      "description": "质押市值"
    },
    {
      "name": "ps_shbt10sh_r",
      "type": "Number",
      "description": "质押股数与前十大股东持股之比"
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 通过公司代码获取",
      "requestBody": {
        "stockCodes": [
          "300750",
          "600519",
          "600157"
        ],
        "token": "***********"
      }
    },
    {
      "desc": "示例2: 通过sortName获取",
      "requestBody": {
        "sortName": "ps_sc_r",
        "sortOrder": "desc",
        "pageIndex": 0,
        "pageSize": 50,
        "token": "***********"
      }
    }
  ]
}