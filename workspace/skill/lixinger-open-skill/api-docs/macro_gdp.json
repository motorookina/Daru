{
  "api": "GDP",
  "apiKey": "macro/gdp",
  "description": {
    "cmn_hans_cn": "获取GDP数据。可按时间范围获取大陆GDP数据，包括国内生产总值、不变价GDP、人均GDP、GNI、第一产业GDP、第二产业GDP、第三产业GDP、第一产业对GDP贡献率、第二产业对GDP贡献率、第三产业对GDP贡献率；美国GDP数据。包括存量及季度新增数据，以及同比环比等数据。当用户想了解经济增长速度或产业结构时，调用此接口。",
    "en": ""
  },
  "url": "https://open.lixinger.com/api/macro/gdp",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "startDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息起始时间。"
      ],
      "constraints": [
        "开始和结束的时间间隔不超过10年"
      ]
    },
    {
      "name": "endDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息结束时间。"
      ]
    },
    {
      "name": "limit",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "返回最近数据的数量。"
      ],
      "constraints": [
        "limit仅在请求数据为date range的情况下生效。"
      ]
    },
    {
      "name": "areaCode",
      "required": "Yes",
      "type": "String",
