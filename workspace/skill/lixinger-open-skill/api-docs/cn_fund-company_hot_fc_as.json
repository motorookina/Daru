{
  "api": "基金公司资产规模API",
  "apiKey": "cn/fund-company/hot/fc_as",
  "description": {
    "cmn_hans_cn": "获取基金公司的最新资产规模数据。可按基金公司代码批量查询，返回基金公司代码、资产规模数据日期、总资产规模、非货币资产规模、混合资产规模、货币资产规模、QDII资产规模、债券资产规模等数据。当用户想查询资产规模最高/最低的前N家基金公司、或者了解某公募基金公司或对比某些公募基金公司的最新管理规模，判断其市场地位时，调用此接口。",
    "en": "Obtain latest asset scale data for fund companies. Supports batch query by fund company codes, returning fields such as fund company code, asset scale data date, total asset scale, non-monetary asset scale, hybrid asset scale, monetary asset scale, QDII asset scale, and bond asset scale. Call this interface when users want to understand the latest management scale of a fund company or assess its market position."
  },
  "url": "https://open.lixinger.com/api/cn/fund-company/hot/fc_as",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "stockCodes",
      "required": "No",
      "type": "Array",
      "descriptions": [
        "基金公司代码数组。"
      ],
      "constraints": [
        "stockCodes长度>=1且<=100。",
        "请参考基金信息API获取合法的stockCode。"
      ],
      "example": "[\"50110000\",\"50030000\"]"
    },
    {
      "name": "sortName",
      "required": "No",
      "type": "String",
      "descriptions": [
        "排序字段。"
      ],
      "constraints": [
        "不提供stockCodes时必填。"
      ]
    },
    {
      "name": "sortOrder",
      "required": "No",
      "type": "String",
      "descriptions": [
        "排序顺序，asc或者desc。"
      ],
      "constraints": [
        "不提供stockCodes时必填。"
      ]
    },
    {
      "name": "pageIndex",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "页码，从0开始。"
      ],
      "constraints": [
        "默认值为 0。必须是大于等于 0 的整数。"
      ]
    },
    {
      "name": "pageSize",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "每页记录数。"
      ],
      "constraints": [
        "取值范围 1 至 100，默认 100。"
      ]
    }
  ],
  "responseParams": [
    {
      "name": "stockCode",
      "type": "String",
      "description": "股票代码"
    },
    {
      "name": "fc_as_d",
      "type": "Date",
      "description": "最新数据时间"
    },
    {
      "name": "fc_as",
      "type": "Number",
      "description": "总资产规模"
    },
    {
      "name": "fc_nb_as",
      "type": "Number",
      "description": "非债券基金资产规模"
    },
    {
      "name": "fc_h_as",
      "type": "Number",
      "description": "混合型资产规模"
    },
    {
      "name": "fc_e_as",
      "type": "Number",
      "description": "股票型资产规模"
    },
    {
      "name": "fc_q_as",
      "type": "Number",
      "description": "QDII型资产规模"
    },
    {
      "name": "fc_b_as",
      "type": "Number",
      "description": "债券型资产规模"
    }
  ],
  "requestExample": [
    {
      "desc": "示例1: 通过基金公司代码获取",
      "requestBody": {
        "stockCodes": [
          "50110000",
          "50030000"
        ],
        "token": "***********"
      }
    },
    {
      "desc": "示例2: 通过sortName获取",
      "requestBody": {
        "sortName": "fc_as_d",
        "sortOrder": "desc",
        "pageIndex": 0,
        "pageSize": 50,
        "token": "***********"
      }
    }
  ]
}