{
  "api": "国外资产",
  "apiKey": "macro/foreign-assets",
  "description": {
    "cmn_hans_cn": "获取央行国外资产数据。可按时间范围获取大陆央行国外资产总计、外汇资产、货币黄金、其他国外资产数据，包括存量及月度新增数据，以及同比环比等数据。当用户想了解外汇储备结构变化时，调用此接口。",
    "en": ""
  },
  "url": "https://open.lixinger.com/api/macro/foreign-assets",
  "method": "POST",
  "params": [
    {
      "name": "token",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "我的Token页有用户专属且唯一的Token。"
      ]
    },
    {
      "name": "startDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息起始时间。"
      ],
      "constraints": [
        "开始和结束的时间间隔不超过10年"
      ]
    },
    {
      "name": "endDate",
      "required": "Yes",
      "type": "String: YYYY-MM-DD(北京时间)",
      "descriptions": [
        "信息结束时间。"
      ]
    },
    {
      "name": "limit",
      "required": "No",
      "type": "Number",
      "descriptions": [
        "返回最近数据的数量。"
      ],
      "constraints": [
        "limit仅在请求数据为date range的情况下生效。"
      ]
    },
    {
      "name": "areaCode",
      "required": "Yes",
      "type": "String",
      "descriptions": [
        "地区代码。"
      ],
      "example": "cn",
      "items": [
        {
          "label": "大陆",
          "value": "cn"
        }
      ]
    },
    {
      "name": "metricsList",
      "required": "Yes",
      "type": "Array",
      "descriptions": [
        "指标数组。"
      ],
      "format": "[granularity].[metricsName].[expressionCalculateType]",
